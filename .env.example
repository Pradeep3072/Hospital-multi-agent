# Application Environment Variables
PROJECT_NAME="Hospital Multi-Agent AI System"
ENVIRONMENT="development"
DEBUG=true

# Database (PostgreSQL default, falls back to SQLite if not provided or unreachable)
DATABASE_URL="postgresql://hospital_user:hospital_password@localhost:5432/hospital_db"
# Fallback local sqlite path: sqlite:///./hospital.db

# Redis (Short term state, session caching, lock mechanism)
REDIS_URL="redis://localhost:6379/0"

# LLM & Google Gemini Configuration
GEMINI_API_KEY="your-gemini-api-key-here"
GEMINI_MODEL="gemini-2.5-flash"

# Security & Tokens
SECRET_KEY="super-secret-hospital-key-change-in-production"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# RAG Configuration
EMBEDDING_MODEL="sentence-transformers/all-MiniLM-L6-v2"
TOP_K_RETRIEVAL=4
USE_BM25_HYBRID=true

# Services
FASTAPI_PORT=8000
STREAMLIT_PORT=8501
